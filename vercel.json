{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/verify-page"
    },
    {
      "source": "/verify",
      "destination": "/api/verify-page"
    },
    {
      "source": "/verify/",
      "destination": "/api/verify-page"
    },
    {
      "source": "/verify/:certificateId",
      "destination": "/api/verify-page?certificateId=:certificateId"
    }
  ]
}
