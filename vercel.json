{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/verify-page.js": { "includeFiles": "public/Verify.html", "maxDuration": 10 },
    "api/verify-api.js": { "maxDuration": 30 },
    "api/workshop.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/verify", "destination": "/api/verify-page" },
    { "source": "/verify/:certificateId", "destination": "/api/verify-page?certificateId=:certificateId" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
