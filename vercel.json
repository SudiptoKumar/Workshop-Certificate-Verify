{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/verify-proxy"
    },
    {
      "source": "/verify",
      "destination": "/api/verify-proxy"
    },
    {
      "source": "/verify/:certificateId",
      "destination": "/api/verify-proxy?certificateId=:certificateId"
    }
  ]
}
